@* Mensaje destacado. Tipo: error, exito, aviso o info. *@
<div class="alerta alerta-@Tipo" role="@(Tipo == "error" ? "alert" : "status")">
    <span class="alerta-icono" aria-hidden="true">@Icono</span>
    <div class="alerta-texto">@ChildContent</div>
</div>

@code {
    [Parameter] public string Tipo { get; set; } = "info";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Icono => Tipo switch
    {
        "error" => "⚠️",
        "exito" => "✅",
        "aviso" => "🔔",
        _ => "ℹ️"
    };
}
