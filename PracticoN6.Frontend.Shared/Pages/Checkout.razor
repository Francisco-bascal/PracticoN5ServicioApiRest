@page "/checkout"
@attribute [Authorize]
@inject TiendaApi Tienda
@inject CarritoService Carrito
@inject SesionService Sesion
@inject NavigationManager Navegacion

<div class="pagina">
    <h1>Pago</h1>

    @if (Carrito.EstaVacio)
    {
        <div class="vacio">
            <div class="vacio-icono">🛒</div>
            <p>No hay productos para pagar.</p>
            <a class="btn btn-primario" href="">Ver el catálogo</a>
        </div>
    }
    else if (_cargando)
    {
        <Cargando />
    }
    else
    {
        <div class="tarjeta">
            <h3>Resumen</h3>
            @foreach (var item in Carrito.Items)
            {
                <div class="fila-detalle" style="display:flex;justify-content:space-between;gap:8px;padding:3px 0">
                    <span>@item.Cantidad × @item.Nombre</span>
                    <span>@Formato.Dinero(item.Subtotal)</span>
                </div>
            }
            <div class="total"><span>Total</span><span>@Formato.Dinero(Carrito.Total)</span></div>
        </div>

        @if (Sesion.EsPersonal)
        {
            <div class="campo">
                <label for="cliente">Venta de mostrador: cliente</label>
                <select id="cliente" @bind="_clienteId">
                    <option value="0">Compra a mi nombre</option>
                    @foreach (var cliente in _clientes)
                    {
                        <option value="@cliente.ClienteId">@cliente.NombreCompleto</option>
                    }
                </select>
            </div>
        }

        <h2>Medio de pago</h2>
        @foreach (var medio in _medios)
        {
            <label class="opcion-pago @(_medioId == medio.MedioPagoId ? "elegida" : "")">
                <input type="radio" name="medio-pago" checked="@(_medioId == medio.MedioPagoId)" @onchange="() => ElegirMedio(medio.MedioPagoId)" />
                <span>@medio.Nombre</span>
            </label>
        }

        @if (MedioElegido?.RequiereTarjeta == true)
        {
            <div class="campo">
                <label for="tarjeta">Número de tarjeta</label>
                <input id="tarjeta" inputmode="numeric" autocomplete="off" placeholder="0000 0000 0000 0000" maxlength="23"
                       @bind="_tarjeta" @bind:event="oninput" />
            </div>
        }

        <Alerta Tipo="info">
            <strong>Pago simulado:</strong> no se realiza ningún cobro real y el número de tarjeta no se guarda.
            Pruebe con <code>4242 4242 4242 4242</code> (aprobada) o <code>4000 0000 0000 0000</code> (rechazada).
        </Alerta>

        @if (_error != null)
        {
            <Alerta Tipo="error">@_error</Alerta>
        }

        <button class="btn btn-acento btn-bloque" disabled="@(_enviando || _medioId == 0)" @onclick="Confirmar">
            @(_enviando ? "Procesando pago..." : $"Pagar {Formato.Dinero(Carrito.Total)}")
        </button>
    }
</div>

@code {
    private List<MedioPago> _medios = new();
    private List<Cliente> _clientes = new();
    private int _medioId;
    private int _clienteId;
    private string _tarjeta = string.Empty;
    private string? _error;
    private bool _cargando = true;
    private bool _enviando;

    private MedioPago? MedioElegido => _medios.FirstOrDefault(m => m.MedioPagoId == _medioId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _medios = await Tienda.ObtenerMediosPagoAsync();

            if (Sesion.EsPersonal)
            {
                _clientes = (await Tienda.ObtenerClientesAsync()).Elementos;
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void ElegirMedio(int id)
    {
        _medioId = id;
        _error = null;
    }

    private async Task Confirmar()
    {
        _error = null;

        if (MedioElegido?.RequiereTarjeta == true)
        {
            int digitos = _tarjeta.Count(char.IsDigit);

            if (digitos < 13 || digitos > 19)
            {
                _error = "Ingrese un número de tarjeta válido (entre 13 y 19 dígitos).";
                return;
            }
        }

        _enviando = true;

        try
        {
            var pedido = await Tienda.ConfirmarCompraAsync(new SolicitudCheckout
            {
                Items = Carrito.Items.Select(i => new ItemCheckout { ProductoId = i.ProductoId, Cantidad = i.Cantidad }).ToList(),
                MedioPagoId = _medioId,
                NumeroTarjeta = MedioElegido?.RequiereTarjeta == true ? _tarjeta : null,
                ClienteId = _clienteId > 0 ? _clienteId : null
            });

            await Carrito.VaciarAsync();
            Navegacion.NavigateTo($"pedidos/{pedido.VentaId}?nuevo=true", replace: true);
        }
        catch (ApiException ex)
        {
            // 402: pago rechazado. 409: sin stock suficiente. En ambos casos el carrito se conserva.
            _error = ex.EsConflicto ? $"{ex.Message} Ajuste las cantidades en el carrito." : ex.Message;
        }
        finally
        {
            _enviando = false;
        }
    }
}
