@page "/registro"
@attribute [AllowAnonymous]
@inject TiendaApi Tienda
@inject SesionService Sesion
@inject NavigationManager Navegacion

<div class="pagina pagina-angosta">
    <h1>Crear cuenta</h1>
    <p class="suave">Con su cuenta podrá comprar y ver el historial de sus pedidos.</p>

    <EditForm Model="_formulario" OnValidSubmit="Registrarse">
        <DataAnnotationsValidator />

        <div class="campo">
            <label for="usuario">Usuario</label>
            <InputText id="usuario" @bind-Value="_formulario.NombreUsuario" autocomplete="username" autocapitalize="none" />
            <ValidationMessage For="() => _formulario.NombreUsuario" />
        </div>
        <div class="campo">
            <label for="email">Correo electrónico</label>
            <InputText id="email" type="email" @bind-Value="_formulario.Email" autocomplete="email" />
            <ValidationMessage For="() => _formulario.Email" />
        </div>
        <div class="campo">
            <label for="password">Contraseña</label>
            <InputText id="password" type="password" @bind-Value="_formulario.Password" autocomplete="new-password" />
            <ValidationMessage For="() => _formulario.Password" />
        </div>
        <div class="campo">
            <label for="confirmar">Repetir contraseña</label>
            <InputText id="confirmar" type="password" @bind-Value="_formulario.ConfirmarPassword" autocomplete="new-password" />
            <ValidationMessage For="() => _formulario.ConfirmarPassword" />
        </div>

        <h2>Sus datos (opcional)</h2>
        <div class="fila-campos">
            <div class="campo">
                <label for="nombre">Nombre</label>
                <InputText id="nombre" @bind-Value="_formulario.Nombre" autocomplete="given-name" />
                <ValidationMessage For="() => _formulario.Nombre" />
            </div>
            <div class="campo">
                <label for="apellido">Apellido</label>
                <InputText id="apellido" @bind-Value="_formulario.Apellido" autocomplete="family-name" />
            </div>
        </div>
        <div class="campo">
            <label for="telefono">Teléfono</label>
            <InputText id="telefono" type="tel" @bind-Value="_formulario.Telefono" autocomplete="tel" />
        </div>
        <div class="campo">
            <label for="direccion">Dirección</label>
            <InputText id="direccion" @bind-Value="_formulario.Direccion" autocomplete="street-address" />
        </div>

        @if (_error != null)
        {
            <Alerta Tipo="error">@_error</Alerta>
        }

        <button class="btn btn-primario btn-bloque" type="submit" disabled="@_enviando">
            @(_enviando ? "Creando cuenta..." : "Crear cuenta")
        </button>
    </EditForm>

    <p class="centrado" style="margin-top:16px">¿Ya tiene cuenta? <a href="login">Inicie sesión</a></p>
</div>

@code {
    private readonly FormularioRegistro _formulario = new();
    private string? _error;
    private bool _enviando;

    private async Task Registrarse()
    {
        _enviando = true;
        _error = null;

        try
        {
            await Tienda.RegistrarseAsync(_formulario);
            await Sesion.IniciarSesionAsync(_formulario.NombreUsuario, _formulario.Password);
            Navegacion.NavigateTo("", replace: true);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _enviando = false;
        }
    }
}
