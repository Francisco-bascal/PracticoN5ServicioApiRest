@page "/admin/clientes"
@attribute [Authorize(Roles = Roles.Personal)]
@inject TiendaApi Tienda

<div class="pagina">
    <h1>Clientes</h1>

    @if (_error != null)
    {
        <Alerta Tipo="error">@_error</Alerta>
    }
    else if (_pagina == null)
    {
        <Cargando />
    }
    else if (_pagina.Elementos.Count == 0)
    {
        <div class="vacio"><div class="vacio-icono">🧑‍🤝‍🧑</div><p>Todavía no hay clientes.</p></div>
    }
    else
    {
        <p class="pequeno suave">@_pagina.TotalElementos @(_pagina.TotalElementos == 1 ? "cliente" : "clientes")</p>

        @foreach (var cliente in _pagina.Elementos)
        {
            <div class="fila">
                <div class="fila-cuerpo">
                    <div class="fila-titulo">@cliente.NombreCompleto</div>
                    <div class="fila-detalle">@string.Join(" · ", new[] { cliente.Email, cliente.Telefono, cliente.Direccion }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                </div>
            </div>
        }

        <Paginador Pagina="_numero" TotalPaginas="_pagina.TotalPaginas" PaginaCambiada="IrAPagina" />
    }
</div>

@code {
    private Pagina<Cliente>? _pagina;
    private int _numero = 1;
    private string? _error;

    protected override Task OnInitializedAsync() => Cargar();

    private Task IrAPagina(int numero)
    {
        _numero = numero;
        return Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            _pagina = await Tienda.ObtenerClientesAsync(_numero, 20);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }
}
