@page "/admin/compras"
@attribute [Authorize(Roles = Roles.Personal)]
@inject TiendaApi Tienda
@inject SesionService Sesion
@inject NotificacionesService Notificaciones

<div class="pagina">
    <h1>Entradas de mercadería</h1>
    <p class="suave">Compras a proveedores: cada una suma stock a los productos comprados.</p>

    <a class="btn btn-acento btn-bloque" href="admin/compras/nueva">＋ Registrar entrada</a>

    @if (_error != null)
    {
        <Alerta Tipo="error">@_error</Alerta>
    }
    else if (_pagina == null)
    {
        <Cargando />
    }
    else if (_pagina.Elementos.Count == 0)
    {
        <div class="vacio"><div class="vacio-icono">🚚</div><p>Todavía no hay entradas registradas.</p></div>
    }
    else
    {
        <div style="margin-top:12px">
            @foreach (var compra in _pagina.Elementos)
            {
                <div class="fila @(compra.Anulada ? "fila-anulada" : "")" style="align-items:flex-start">
                    <div class="fila-cuerpo">
                        <div class="fila-titulo">Compra N° @compra.CompraId @if (compra.Anulada){<span class="etiqueta etiqueta-peligro">Anulada</span>}</div>
                        <div class="fila-detalle">@Formato.FechaHora(compra.Fecha) · @compra.Proveedor?.Nombre</div>
                        <div class="fila-detalle">
                            @string.Join(", ", compra.Detalles.Select(d => $"{d.Cantidad} × {d.Producto?.Nombre}"))
                        </div>
                    </div>
                    <div class="fila-derecha">
                        <div class="fila-titulo">@Formato.Dinero(compra.Total)</div>
                        @if (Sesion.EsAdministrador && !compra.Anulada)
                        {
                            <button class="btn btn-enlace" style="color:var(--peligro)" @onclick="() => _porAnular = compra">Anular</button>
                        }
                    </div>
                </div>
            }
        </div>

        <Paginador Pagina="_numero" TotalPaginas="_pagina.TotalPaginas" PaginaCambiada="IrAPagina" />
    }
</div>

<DialogoConfirmacion Visible="_porAnular != null" Titulo="Anular compra" Peligro="true" TextoConfirmar="Anular"
                     Mensaje="@($"¿Anular la compra N° {_porAnular?.CompraId}? Se descontará del stock lo que había sumado.")"
                     Confirmado="Anular" Cancelado="() => _porAnular = null" />

@code {
    private Pagina<Compra>? _pagina;
    private Compra? _porAnular;
    private int _numero = 1;
    private string? _error;

    protected override Task OnInitializedAsync() => Cargar();

    private Task IrAPagina(int numero)
    {
        _numero = numero;
        return Cargar();
    }

    private async Task Cargar()
    {
        _error = null;

        try
        {
            _pagina = await Tienda.ObtenerComprasAsync(_numero);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Anular()
    {
        var compra = _porAnular!;
        _porAnular = null;

        try
        {
            await Tienda.AnularCompraAsync(compra.CompraId);
            Notificaciones.Exito($"Compra N° {compra.CompraId} anulada.");
            await Cargar();
        }
        catch (ApiException ex)
        {
            // Típico: 409 porque el stock comprado ya se vendió.
            Notificaciones.Error(ex.Message);
        }
    }
}
