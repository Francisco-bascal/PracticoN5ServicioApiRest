@page "/admin/errores"
@attribute [Authorize(Roles = Roles.Administrador)]
@inject TiendaApi Tienda

<div class="pagina">
    <h1>Registro de errores</h1>
    <p class="suave">Errores no controlados del servidor y de la aplicación móvil.</p>

    <div class="chips">
        <button class="chip @(_origen == "" ? "activo" : "")" @onclick='() => Filtrar("")'>Todos</button>
        <button class="chip @(_origen == "API" ? "activo" : "")" @onclick='() => Filtrar("API")'>Servidor</button>
        <button class="chip @(_origen == "App" ? "activo" : "")" @onclick='() => Filtrar("App")'>Aplicación</button>
    </div>

    @if (_error != null)
    {
        <Alerta Tipo="error">@_error</Alerta>
    }
    else if (_pagina == null)
    {
        <Cargando />
    }
    else if (_pagina.Elementos.Count == 0)
    {
        <div class="vacio"><div class="vacio-icono">🎉</div><p>No hay errores registrados.</p></div>
    }
    else
    {
        <p class="pequeno suave">@_pagina.TotalElementos errores</p>

        @foreach (var error in _pagina.Elementos)
        {
            <div class="tarjeta">
                <div class="fila-titulo">
                    <span class="etiqueta @(error.Origen == "API" ? "etiqueta-peligro" : "etiqueta-aviso")">@error.Origen</span>
                    #@error.RegistroErrorId · @error.Mensaje
                </div>
                <div class="fila-detalle">
                    @Formato.FechaHora(error.Fecha)
                    @if (!string.IsNullOrWhiteSpace(error.Metodo)) { <text> · @error.Metodo</text> }
                    @if (!string.IsNullOrWhiteSpace(error.Ruta)) { <text> @error.Ruta</text> }
                    @if (!string.IsNullOrWhiteSpace(error.Usuario)) { <text> · @error.Usuario</text> }
                </div>
                @if (!string.IsNullOrWhiteSpace(error.StackTrace))
                {
                    <details>
                        <summary>@(error.TipoExcepcion ?? "Detalle técnico")</summary>
                        <pre class="traza">@error.StackTrace</pre>
                    </details>
                }
            </div>
        }

        <Paginador Pagina="_numero" TotalPaginas="_pagina.TotalPaginas" PaginaCambiada="IrAPagina" />
    }
</div>

@code {
    private Pagina<RegistroError>? _pagina;
    private string _origen = string.Empty;
    private int _numero = 1;
    private string? _error;

    protected override Task OnInitializedAsync() => Cargar();

    private Task Filtrar(string origen)
    {
        _origen = origen;
        return IrAPagina(1);
    }

    private Task IrAPagina(int numero)
    {
        _numero = numero;
        return Cargar();
    }

    private async Task Cargar()
    {
        _error = null;

        try
        {
            _pagina = await Tienda.ObtenerErroresAsync(_origen, _numero);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }
}
