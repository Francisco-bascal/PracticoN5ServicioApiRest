@page "/admin"
@attribute [Authorize(Roles = Roles.Personal)]
@inject SesionService Sesion

<div class="pagina">
    <h1>Panel de gestión</h1>
    <p class="suave">Sesión iniciada como <strong>@Sesion.NombreUsuario</strong> (@Sesion.Rol).</p>

    <h2>Catálogo y stock</h2>
    <div class="grilla-panel">
        <a class="atajo" href="admin/productos"><span class="atajo-icono">📦</span>Productos<small>Precios, stock e imágenes</small></a>
        <a class="atajo" href="admin/categorias"><span class="atajo-icono">🗂️</span>Categorías</a>
        <a class="atajo" href="admin/movimientos"><span class="atajo-icono">🔄</span>Movimientos<small>Entradas y salidas de stock</small></a>
    </div>

    <h2>Compras y ventas</h2>
    <div class="grilla-panel">
        <a class="atajo" href="admin/compras"><span class="atajo-icono">🚚</span>Entradas<small>Compras a proveedores</small></a>
        <a class="atajo" href="admin/ventas"><span class="atajo-icono">🧾</span>Ventas</a>
        <a class="atajo" href="admin/reportes"><span class="atajo-icono">📊</span>Reportes PDF</a>
        <a class="atajo" href="admin/proveedores"><span class="atajo-icono">🏭</span>Proveedores</a>
        <a class="atajo" href="admin/clientes"><span class="atajo-icono">🧑‍🤝‍🧑</span>Clientes</a>
    </div>

    @if (Sesion.EsAdministrador)
    {
        <h2>Administración</h2>
        <div class="grilla-panel">
            <a class="atajo" href="admin/usuarios"><span class="atajo-icono">🔐</span>Usuarios y roles</a>
            <a class="atajo" href="admin/auditoria"><span class="atajo-icono">🕵️</span>Auditoría<small>Quién hizo qué</small></a>
            <a class="atajo" href="admin/errores"><span class="atajo-icono">🐞</span>Errores<small>Registro de fallas</small></a>
        </div>
    }
</div>
