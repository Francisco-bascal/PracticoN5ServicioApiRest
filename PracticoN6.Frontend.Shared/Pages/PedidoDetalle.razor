@page "/pedidos/{Id:int}"
@attribute [Authorize]
@inject TiendaApi Tienda
@inject SesionService Sesion
@inject IGestorArchivos Archivos
@inject NotificacionesService Notificaciones

<div class="pagina">
    @if (_error != null)
    {
        <Alerta Tipo="error">@_error</Alerta>
    }
    else if (_pedido == null)
    {
        <Cargando />
    }
    else
    {
        @if (Nuevo)
        {
            <Alerta Tipo="exito"><strong>¡Compra realizada!</strong> Su pago fue aprobado.</Alerta>
        }

        <h1>Pedido N° @_pedido.VentaId @if (_pedido.Anulada){<span class="etiqueta etiqueta-peligro">Anulado</span>}</h1>
        <p class="suave">@Formato.FechaHora(_pedido.Fecha) · @_pedido.Cliente</p>

        @foreach (var item in _pedido.Items)
        {
            <div class="fila">
                <div class="fila-cuerpo">
                    <div class="fila-titulo">@item.Producto</div>
                    <div class="fila-detalle">@item.Cantidad × @Formato.Dinero(item.PrecioUnitario)</div>
                </div>
                <div class="fila-derecha fila-titulo">@Formato.Dinero(item.Subtotal)</div>
            </div>
        }

        <div class="total"><span>Total</span><span>@Formato.Dinero(_pedido.Total)</span></div>

        @if (_pedido.MedioPago != null)
        {
            <p class="suave">Pagado con <strong>@_pedido.MedioPago</strong> · código de autorización <strong>@_pedido.CodigoAutorizacion</strong></p>
        }

        @if (Sesion.EsPersonal)
        {
            <div class="campo">
                <label for="destino">Enviar a (opcional)</label>
                <input id="destino" type="email" placeholder="Si lo deja vacío se envía a su correo" @bind="_destinatario" />
            </div>
        }

        @if (_resultado != null)
        {
            <Alerta Tipo="@(_resultado.Enviado ? "exito" : "aviso")">@_resultado.Mensaje</Alerta>
        }

        @if (_errorAccion != null)
        {
            <Alerta Tipo="error">@_errorAccion</Alerta>
        }

        <div class="acciones">
            <button class="btn btn-secundario" disabled="@_ocupado" @onclick="VerComprobante">📄 Comprobante PDF</button>
            <button class="btn btn-primario" disabled="@_ocupado" @onclick="Enviar">✉️ Enviar por correo</button>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public bool Nuevo { get; set; }

    private Pedido? _pedido;
    private ResultadoEnvio? _resultado;
    private string? _error;
    private string? _errorAccion;
    private string? _destinatario;
    private bool _ocupado;

    protected override async Task OnParametersSetAsync()
    {
        _pedido = null;
        _error = null;

        try
        {
            _pedido = await Tienda.ObtenerPedidoAsync(Id);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task VerComprobante()
    {
        _ocupado = true;
        _errorAccion = null;

        try
        {
            byte[] pdf = await Tienda.ObtenerComprobanteAsync(Id);
            await Archivos.GuardarYCompartirAsync($"comprobante-{Id}.pdf", pdf, "application/pdf");
        }
        catch (ApiException ex)
        {
            _errorAccion = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task Enviar()
    {
        _ocupado = true;
        _errorAccion = null;
        _resultado = null;

        try
        {
            _resultado = await Tienda.EnviarComprobanteAsync(Id, _destinatario);
            Notificaciones.Mostrar(_resultado.Enviado ? "Comprobante enviado." : "El correo no se envió (ver detalle).", _resultado.Enviado ? "exito" : "info");
        }
        catch (ApiException ex)
        {
            _errorAccion = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }
}
