@using PracticoN6.Frontend.Shared.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="rutaDatos">
            <AuthorizeRouteView RouteData="@rutaDatos" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="pagina">
                            <h1>Acceso restringido</h1>
                            <Alerta Tipo="error">Su usuario no tiene permisos para ver esta pantalla.</Alerta>
                            <a class="btn btn-primario" href="">Ir al catálogo</a>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <Cargando Texto="Iniciando..." />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@rutaDatos" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="pagina">
                    <h1>Pantalla no encontrada</h1>
                    <p>La dirección que buscaba no existe.</p>
                    <a class="btn btn-primario" href="">Ir al catálogo</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
